# Copy this file to bridge.conf and edit the values.

# Known-good phone MAC from the working Tyrion snapshot.
PHONE_MAC=58:43:AB:D9:8C:6E

# Bluetooth controller alias shown on the phone.
BT_ALIAS=PiCallBridge

# Bluetooth HCI device.
BT_HCI=hci0

# Force headset-style "Just Works" pairing at both layers:
#   BT_AGENT_CAPABILITY -> bluetoothctl agent capability
#   BT_IO_CAPABILITY    -> btmgmt controller IO capability (0x03 = NoInputNoOutput)
BT_AGENT_CAPABILITY=NoInputNoOutput
BT_IO_CAPABILITY=0x03

# ALSA playback target for the call downlink (Pi -> AUX / headphones jack).
# Example from many Raspberry Pi images:
AUX_PCM=plughw:CARD=Headphones,DEV=0

# ALSA capture source for the call uplink (USB webcam microphone -> phone).
# Example for Logitech C920 microphone:
MIC_PCM=plughw:CARD=C920,DEV=0

# Uplink source:
#   mic        -> capture from MIC_PCM
#   file       -> loop the audio file below into the call instead of the mic
#   soundboard -> watch SOUNDBOARD_SELECTOR_PATH so you can hot-swap clips
UPLINK_SOURCE=mic

# Used when UPLINK_SOURCE=file and as the fallback/default clip for soundboard
# mode. Relative paths are resolved from the directory containing bridge.conf.
UPLINK_AUDIO_FILE=audio/KBC_PRANK.mp3

# Used when UPLINK_SOURCE=soundboard. The terminal UI writes the currently
# selected clip to this file, and the bridge watches it live.
SOUNDBOARD_SELECTOR_PATH=.soundboard-current.txt

# 16000 works well for HFP mSBC and will be converted down if the call falls back to CVSD.
SCO_RATE=16000

# Optional copy of the uplink PCM stream:
#   off     -> no extra stream copy
#   file    -> append raw PCM to UPLINK_TAP_PATH (regular file or FIFO)
#   command -> pipe raw PCM to UPLINK_TAP_COMMAND on stdin
UPLINK_TAP_MODE=off
UPLINK_TAP_PATH=/tmp/bt-call-bridge-uplink.pcm
UPLINK_TAP_COMMAND=

# Re-attempt bluetoothctl connect/trust while the bridge runs.
AUTO_CONNECT=1

# Keep adapter visible/pairable.
DISCOVERABLE=1
PAIRABLE=1
PAIRABLE_TIMEOUT=0
DISCOVERABLE_TIMEOUT=0

# BlueALSA tuning.
BLUEALSA_INITIAL_VOLUME=70
BLUEALSA_KEEP_ALIVE=-1
BLUEALSA_IO_RT_PRIORITY=20
ENABLE_A2DP_SINK=0
BLUEALSA_EXTRA_ARGS=

# Delay before restarting failed child processes.
RESTART_DELAY_SECS=2
